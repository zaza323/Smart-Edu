rules_version = '2';

// ============================================================================
//  Smart Edu Pro — بنك الأسئلة | قواعد أمان Firestore
// ----------------------------------------------------------------------------
//  القاعدة الذهبية (قسم 9 من الـ PRD):
//  - العميل (المتصفح) لا يستطيع قراءة مجموعة `questions` إطلاقاً، حتى لو كان
//    مشتركاً. الأسئلة تُجلب حصراً عبر Cloud Function تتحقق من الاشتراك أولاً
//    وتحذف `correctAnswerIndex` قبل الإرسال.
//  - العميل لا يستطيع الكتابة في `attempts` ولا تعديل `subscriptions` الخاصة به.
//    كل ذلك يتم عبر Admin SDK داخل Cloud Functions (يتجاوز هذه القواعد).
//  ملاحظة: مجموعات الموقع القديم (المعلمين) غير مذكورة هنا؛ احرص عند النشر على
//  دمج هذا الملف مع قواعدك القائمة إن وُجدت بدل استبدالها.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- دوال مساعدة ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // الاعتماد على Custom Claim (يُضبط عبر scripts/set-admin.js)
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- users ----------
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      // إنشاء مستند الطالب لحظة التسجيل — بقيم مقيّدة لا يمكن تزويرها
      allow create: if isOwner(uid)
                    && request.resource.data.role == 'student'
                    && request.resource.data.subscriptions.size() == 0
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() > 2
                    && request.resource.data.phone is string
                    && request.resource.data.grade is string;

      // الطالب يعدّل الاسم والهاتف فقط — لا الدور ولا الاشتراكات
      allow update: if isAdmin()
                    || (isOwner(uid)
                        && changedKeys().hasOnly(['fullName', 'phone', 'grade', 'updatedAt']));

      allow delete: if isAdmin();
    }

    // ---------- subjects (كتالوج المواد والأسعار) ----------
    match /subjects/{subjectId} {
      allow read: if true;          // كتالوج عام: يظهر بصفحة الهبوط قبل التسجيل
      allow write: if isAdmin();
    }

    // ---------- bundles (باقات: عدة مواد بسعر واحد) ----------
    // عامة مثل المواد لتظهر بالصفحة الرئيسية. تفعيل الباقة يقرأ موادها من هنا
    // داخل Cloud Function، فلا يستطيع الطالب تحديد ما يُفعَّل له.
    match /bundles/{bundleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- settings (بيانات التحويل البنكي، إعدادات عامة) ----------
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- questions (مقفلة تماماً أمام العميل) ----------
    match /questions/{questionId} {
      allow read: if isAdmin();     // الأدمن فقط (لواجهة إدارة الأسئلة)
      allow write: if isAdmin();
      // الطالب: لا get ولا list — الوصول حصراً عبر Cloud Function `startExam`
    }

    // ---------- paymentRequests ----------
    match /paymentRequests/{requestId} {
      allow get: if isAdmin() || isOwner(resource.data.uid);

      // في استعلامات list تُقيَّم القاعدة على كل مستند مُعاد، لذلك يفشل الاستعلام
      // ما لم يُقيّده العميل بـ where('uid','==', currentUid) — وهذا هو المطلوب.
      allow list: if isAdmin() || isOwner(resource.data.uid);

      allow create: if isSignedIn()
                    && isOwner(request.resource.data.uid)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.proofImageUrl is string
                    && request.resource.data.subjectId is string;

      // القبول/الرفض يتم عبر Cloud Function بصلاحيات Admin SDK
      allow update, delete: if isAdmin();
    }

    // ---------- attempts (محاولات الاختبار) ----------
    match /attempts/{attemptId} {
      allow get: if isAdmin() || isOwner(resource.data.uid);
      allow list: if isAdmin() || isOwner(resource.data.uid);
      // لا كتابة من العميل إطلاقاً — الإنشاء والتصحيح عبر Cloud Functions
      allow write: if false;
    }

    // ---------- leaderboard (لوحة الأبطال) ----------
    // مجموعة عرض عامة مقصودة: تحمل الاسم والصف والنقاط فقط — بلا بريد ولا هاتف.
    // وُجدت تحديداً حتى لا نضطر لفتح `users` للقراءة أمام كل الطلاب.
    match /leaderboard/{uid} {
      allow get, list: if isSignedIn();

      // النقاط تُكتب حصراً من Cloud Function التصحيح (Admin SDK يتجاوز القواعد).
      allow create, delete: if isAdmin();

      // الطالب يزامن اسمه وصفه فقط عند تعديلهما من صفحة «حسابي» — لا النقاط.
      allow update: if isAdmin()
                    || (isOwner(uid) && changedKeys().hasOnly(['fullName', 'grade']));
    }

    // ---------- importJobs (سجلات استيراد ملفات Word) ----------
    match /importJobs/{jobId} {
      allow read, create: if isAdmin();
      // الحالة والنتائج تُكتب من Cloud Function عبر Admin SDK
      allow update, delete: if isAdmin();
    }

    // ---------- questionStats (إحصائيات الأسئلة الأكثر خطأً) ----------
    match /questionStats/{questionId} {
      allow read: if isAdmin();
      allow write: if false;        // تُحدَّث عبر Cloud Function فقط
    }

    // ---------- منع أي شيء آخر ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
